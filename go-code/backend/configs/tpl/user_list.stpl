SELECT *
FROM `user` u WHERE del=0
    {%if SearchUserAccount%}
       and u.account like '%{{SearchUserAccount}}%'
     {%endif%}

     {%if SearchUserNickname%}
        and u.nickname like '%{{SearchUserNickname}}%'
      {%endif%}

      {%if SearchUserEmail%}
          and u.email like '%{{SearchUserEmail}}%'
        {%endif%}

       {%if SearchUserPhoneNum%}
         and u.phone_num like '%{{SearchUserPhoneNum}}%'
       {%endif%}

       {%if SearchUserSex%}
        and u.sex = '{{SearchUserSex}}'
      {%endif%}

      {%if SearchUserDisabled == "enabled"%}
         and u.is_disabled = false
     {%elif SearchUserDisabled == "disabled"%}
         and u.is_disabled = true
     {%endif%}

order by u.update_at desc, u.id desc
{%if PageSize>0 and PageNumber>0%}
limit {{PageSize}} offset {{PageSize*(PageNumber-1)}}
{%endif%}