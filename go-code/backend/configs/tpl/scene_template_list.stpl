select  distinct * from scene_template  as d
    where 1=1
    and d.del = 0
      {%if SearchSceneDisabled == "enabled"%}
                    and d.is_disabled = false
                {%elif SearchSceneDisabled == "disabled"%}
                    and d.is_disabled = true
                {%endif%}
     {%if SearchSceneName%}
      and d.name like '%{{SearchSceneName}}%'
     {%endif%}

order by d.update_at desc, d.id desc
{%if PageSize>0 and PageNumber>0%}
limit {{PageSize}} offset {{PageSize*(PageNumber-1)}}
{%endif%}
