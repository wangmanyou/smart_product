server {
    listen       8080;
    client_max_body_size 10G;
    proxy_connect_timeout 600s;  # 连接时间
    proxy_send_timeout 600s;   # 代理服务器发送时间
    proxy_read_timeout 600s;   # 等待时间
    charset utf-8;
    location  / {
        root   /usr/share/nginx/html;
        try_files $uri $uri/ /;
        index  index.html index.htm;
    }
    
    location /api {  
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Real-PORT $remote_port;
        proxy_set_header Origin '';
        add_header Access-Control-Allow-Credentials true;
        add_header Access-Control-Allow-Headers $http_access_control_request_headers;
        add_header Access-Control-Allow-Methods POST,GET,OPTIONS,DELETE,PUT,HEAD,PATCH;
        add_header Access-Control-Allow-Origin $http_origin;
        add_header Access-Control-Expose-Headers $http_access_control_request_headers;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
        chunked_transfer_encoding off;
        proxy_cache off;
        rewrite ^/api(.*)$ $1 break;
        proxy_pass ${PROXY_PASS};

        # proxy_pass http://api_server:9000;
    }

    location /data {  
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Real-PORT $remote_port;
        proxy_set_header Origin '';
        add_header Access-Control-Allow-Credentials true;
        add_header Access-Control-Allow-Headers $http_access_control_request_headers;
        add_header Access-Control-Allow-Methods POST,GET,OPTIONS,DELETE,PUT,HEAD,PATCH;
        add_header Access-Control-Allow-Origin $http_origin;
        add_header Access-Control-Expose-Headers $http_access_control_request_headers;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
        chunked_transfer_encoding off;
        proxy_cache off;
        
        proxy_pass ${PROXY_PASS};
    }

    error_page 404 /404.html;
        location = /40x.html {
    }

    error_page 500 502 503 504 /50x.html;
        location = /50x.html {
    }
}