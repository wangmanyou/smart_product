# Copy this file to .env.server before starting the Spring server stack.
# Never commit or upload .env.server.

# This value must match the password of an existing MySQL data directory.
SPRING_MYSQL_ROOT_PASSWORD=replace-with-the-current-strong-password

# Relative to new-code/docker-compose.server.yml by default.
# Keep this outside the release package so upgrades do not overwrite runtime data.
SPRING_SERVER_DATA_ROOT=../spring-runtime-data/prod

# This is a FILE PATH only, not the JWT secret itself.
# The actual file must be generated separately on the server and kept outside the release package.
SPRING_JWT_SECRET_FILE=../spring-server-secrets/jwt-secret

# Keep these values stable unless you intentionally want all existing Spring tokens to become invalid.
SPRING_JWT_ISSUER=smart-product-spring
SPRING_JWT_AUDIENCE=smart-product-web
SPRING_JWT_TTL_SECONDS=86400
