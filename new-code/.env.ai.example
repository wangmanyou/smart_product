# Copy to .env.ai.local and fill real values, or run:
#   .\deploy\ragflow\scripts\set-backend-api-key.ps1
# This file is for running the Spring Boot backend directly on the host.
APP_AI_ENABLED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=replace-with-ragflow-api-key
RAGFLOW_CONNECT_TIMEOUT=5s
RAGFLOW_READ_TIMEOUT=60s

# The Spring service uses this OpenAI-compatible model to generate the final answer.
# RAGFlow still needs its own embedding model configured in the RAGFlow UI.
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name
LLM_TEMPERATURE=0.1
LLM_CONNECT_TIMEOUT=5s
LLM_READ_TIMEOUT=90s
LLM_MAX_OUTPUT_TOKENS=1200

AI_RETRIEVAL_TOP_K=8
AI_RETRIEVAL_CANDIDATE_TOP_K=64
AI_RETRIEVAL_MAX_CONTEXT_CHARS=16000
AI_HISTORY_MESSAGE_LIMIT=8
AI_RETRIEVAL_SIMILARITY_THRESHOLD=0.25

# On first AI-enabled startup, queue all existing business knowledge for RAGFlow sync.
AI_SYNC_BOOTSTRAP_ENABLED=true

