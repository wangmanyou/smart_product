# Copy this file to .env.next before starting the upgrade parallel stack.
# Never commit or upload .env.next after filling real values.

# This password belongs only to the upgrade parallel MySQL.
# If NEXT_SERVER_DATA_ROOT is empty, MySQL will initialize with this password.
# If the data directory already exists, this value must match that existing MySQL data directory.
NEXT_MYSQL_ROOT_PASSWORD=replace-with-a-strong-next-password

# Keep this outside the release package so upgrades do not overwrite runtime data.
# Recommended server path: /opt/smart-product-next/deploy-data
NEXT_SERVER_DATA_ROOT=../deploy-data

# This is a FILE PATH only, not the JWT secret itself.
# Recommended server path: /opt/smart-product-next/server-secrets/jwt-secret
NEXT_JWT_SECRET_FILE=../server-secrets/jwt-secret

# Keep these stable within the upgrade parallel environment unless you want its tokens to expire.
NEXT_JWT_ISSUER=smart-product-next
NEXT_JWT_AUDIENCE=smart-product-next-web
NEXT_JWT_TTL_SECONDS=86400
