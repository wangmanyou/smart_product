select distinct * from dict_template  as d
    where 1=1
    and d.del = 0

     {%if SearchDictType%}
       and d.type = '{{SearchDictType}}'
     {%endif%}

     {%if SearchDictDisabled == "enabled"%}
           and d.is_disabled = false
       {%elif SearchDictDisabled == "disabled"%}
           and d.is_disabled = true
       {%endif%}

     {%if SearchDictName%}
      and d.name like '%{{SearchDictName}}%'
     {%endif%}

     order by d.update_at desc, d.id desc
{%if PageSize>0 and PageNumber>0%}
limit {{PageSize}} offset {{PageSize*(PageNumber-1)}}
{%endif%}